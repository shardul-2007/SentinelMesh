# SentinelMesh Environment Configuration Example

# Environment Mode
ENV=development

# Application Security
APP_SECRET_KEY=change_this_to_a_random_secure_hex_key_in_production
ADMIN_KEY=sentinel-admin-dev-key-phase1

# Database Configuration
# Local SQLite:
DATABASE_URL=sqlite:///./sentinelmesh.db
# Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinelmesh

# MST Blockchain Network Configuration
# Testnet (Default):
BLOCKCHAIN_RPC_URL=https://testnetrpc.mstblockchain.com
BLOCKCHAIN_CHAIN_ID=91562037
BLOCKCHAIN_NETWORK_NAME=MST Testnet
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_KEY=

# Mainnet (When configured and authorized):
# BLOCKCHAIN_RPC_URL=https://mariorpc.mstblockchain.com/
# BLOCKCHAIN_CHAIN_ID=4646
# BLOCKCHAIN_NETWORK_NAME=MST Mainnet
# BLOCKCHAIN_CONTRACT_ADDRESS=
# BLOCKCHAIN_SIGNER_KEY=

# Explorer Links
MSTSCAN_EXPLORER_URL=https://testnet.mstscan.com
MST_FAUCET_URL=https://faucet.mstblockchain.com
